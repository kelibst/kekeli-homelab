# Kekeli-HomeCloud Environment Configuration Example
# Copy this file to .env and customize the values for your installation
#
# SECURITY WARNING: Never commit the actual .env file to version control!
# The .env file contains sensitive passwords and should be kept private.

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# HOST_IP: Desired static IP address for this machine (OPTIONAL)
# If set, the installer will automatically configure your system to use this IP
# This ensures your Nextcloud URL remains consistent after reboots
#
# REQUIREMENTS:
# - IP must be in your router's subnet (e.g., 192.168.1.x for 192.168.1.0/24 network)
# - IP should not conflict with your router's DHCP range (check router settings)
# - Leave empty for automatic IP detection (DHCP)
#
# EXAMPLES:
#   HOST_IP=192.168.1.98    # Sets static IP to 192.168.1.98
#   HOST_IP=10.0.0.50       # Sets static IP to 10.0.0.50
#   HOST_IP=                # Use DHCP (automatic IP assignment)
#
# BENEFITS OF STATIC IP:
# ✓ Consistent URL for family access (http://192.168.1.98:8080)
# ✓ No need to update mobile apps after reboot
# ✓ Reliable bookmarks for family members
# ✓ Automatic configuration by installer
#
HOST_IP=

# Primary network configuration for family access
# This is the IP address family members will use to access Nextcloud
# Example: If your router assigns 192.168.1.100, set PRIMARY_DOMAIN=192.168.1.100
# For consistent access, consider setting up DHCP reservation or static IP
PRIMARY_DOMAIN=

# Protocol for accessing Nextcloud (http for local network, https if you have SSL)
PROTOCOL=http

# Port for HTTP access (default: 8080, change if this port is already in use)
NEXTCLOUD_HTTP_PORT=8080

# Port for HTTPS access (default: 8443, only needed if using SSL)
NEXTCLOUD_HTTPS_PORT=8443

# Trusted domains (comma-separated list of IPs/domains that can access Nextcloud)
# This will be automatically populated during setup, but you can customize it
# Example: 192.168.1.100,192.168.1.100:8080,localhost,localhost:8080
TRUSTED_DOMAINS=

# =============================================================================
# MOBILE & FAMILY ACCESS CONFIGURATION
# =============================================================================

# MOBILE_URL: Your preferred URL for family/mobile access to Nextcloud
# If set, this overrides auto-detection and ensures consistent family access
# This should be the URL that family members bookmark and use on mobile devices
#
# WHEN TO USE:
# - You have a static IP or DHCP reservation set up
# - You want consistent access after router/computer reboots
# - Auto-detection picks the wrong IP or interface
# - You're using a custom port or different IP than detected
#
# FORMAT: http://IP_ADDRESS:PORT (or https:// if you have SSL)
# Examples:
#   MOBILE_URL=http://192.168.1.100:8080    # Common home network with static IP
#   MOBILE_URL=http://10.0.1.50:8080        # Corporate/advanced home network
#   MOBILE_URL=http://192.168.0.15:9000     # Custom port configuration
#   MOBILE_URL=https://nextcloud.local:8443  # Local hostname with SSL
#
# SETUP STEPS:
# 1. Set up static IP or DHCP reservation on your router
# 2. Set MOBILE_URL to your chosen IP and port
# 3. Test access from family devices: mobile app + bookmark
# 4. Verify access persists after computer/router restart
#
# If not set, the system will auto-detect your network configuration
MOBILE_URL=

# =============================================================================
# ADVANCED STATIC IP CONFIGURATION (Optional)
# =============================================================================

# For users experiencing frequent IP changes (Starlink, CGNAT, frequent reboots)
# Run: ./scripts/setup-static-ip.sh to configure these automatically
#
# Available methods: none, macvlan, avahi, duckdns, combo, pihole, tailscale
STATIC_IP_METHOD=none

# -----------------------------------------------------------------------------
# Docker Macvlan Configuration (Approach 1 - Recommended for local network)
# -----------------------------------------------------------------------------
# Gives your Nextcloud container its own static IP on the local network
# The container appears as a separate device with a persistent IP
#
# BENEFITS:
# ✓ True static IP independent of host
# ✓ Survives reboots without configuration
# ✓ No router access needed
# ✓ Container appears as separate device on network
#
# USE CASE: Starlink Mini, frequent reboots, CGNAT networks
# COMPLEXITY: ⭐⭐ Moderate
#
MACVLAN_ENABLED=false
MACVLAN_PARENT_INTERFACE=       # Your network interface (e.g., eth0, enx26baeba75e55)
MACVLAN_SUBNET=                 # Network subnet (e.g., 10.237.73.0/24, 192.168.1.0/24)
MACVLAN_GATEWAY=                # Network gateway (e.g., 10.237.73.193, 192.168.1.1)
MACVLAN_IP_RANGE=               # IP for container (e.g., 10.237.73.150/32, 192.168.1.150/32)
MACVLAN_CONTAINER_IP=           # Static IP address (e.g., 10.237.73.150, 192.168.1.150)

# Example configuration for Starlink:
#   MACVLAN_PARENT_INTERFACE=enx26baeba75e55
#   MACVLAN_SUBNET=10.237.73.0/24
#   MACVLAN_GATEWAY=10.237.73.193
#   MACVLAN_IP_RANGE=10.237.73.150/32
#   MACVLAN_CONTAINER_IP=10.237.73.150

# -----------------------------------------------------------------------------
# Avahi mDNS Configuration (Approach 2 - User-friendly hostnames)
# -----------------------------------------------------------------------------
# Access Nextcloud via easy-to-remember hostname like "nextcloud.local"
# Works on iOS, Android, macOS, and Linux without additional setup
#
# BENEFITS:
# ✓ Easy to remember (no IP memorization)
# ✓ Works on all modern mobile devices natively
# ✓ Free, no external services
# ✓ Hostname persists across IP changes
#
# USE CASE: Home networks where you want easy hostname access
# COMPLEXITY: ⭐⭐ Moderate
#
AVAHI_ENABLED=false
AVAHI_HOSTNAME=nextcloud        # Will be accessible as nextcloud.local

# Example access URLs:
#   http://nextcloud.local:8080
#   http://mycloud.local:8080

# -----------------------------------------------------------------------------
# DuckDNS Configuration (Approach 3 - Internet + Local Access)
# -----------------------------------------------------------------------------
# Free subdomain that automatically updates with your current IP
# Works from anywhere (local network + internet)
#
# BENEFITS:
# ✓ Works from anywhere (not just local network)
# ✓ Free forever
# ✓ Automatic IP updates (every 5 minutes)
# ✓ Easy to remember domain name
# ✓ No router configuration needed
#
# USE CASE: Need internet access to Nextcloud from cellular/other WiFi
# COMPLEXITY: ⭐ Easy
#
# SETUP STEPS:
# 1. Visit https://www.duckdns.org
# 2. Login with Google/GitHub (no registration needed)
# 3. Create subdomain (e.g., "mycloud")
# 4. Copy your token
# 5. Enter both below
#
DUCKDNS_ENABLED=false
DUCKDNS_SUBDOMAIN=              # Your subdomain (without .duckdns.org)
DUCKDNS_TOKEN=                  # Your DuckDNS token from duckdns.org

# Example configuration:
#   DUCKDNS_SUBDOMAIN=mycloud
#   Access URL: http://mycloud.duckdns.org:8080

# -----------------------------------------------------------------------------
# Starlink-Specific Settings
# -----------------------------------------------------------------------------
# Enable if you're using Starlink Mini or similar with frequent reboots
# Recommended approach: Macvlan + Avahi combo (set STATIC_IP_METHOD=combo)
#
STARLINK_MODE=false             # Enable Starlink-optimized settings
STARLINK_REBOOT_FREQUENCY=60    # How often router reboots (minutes)

# -----------------------------------------------------------------------------
# Recommended Combinations
# -----------------------------------------------------------------------------
#
# COMBO 1 - Best for Starlink/Frequent Reboots (RECOMMENDED):
#   STATIC_IP_METHOD=combo
#   MACVLAN_ENABLED=true          (with configuration above)
#   AVAHI_ENABLED=true
#   Result: Static IP + easy hostname, survives hourly reboots
#
# COMBO 2 - Internet Access + Local Network:
#   STATIC_IP_METHOD=duckdns
#   DUCKDNS_ENABLED=true
#   Result: Access from anywhere with persistent domain
#
# COMBO 3 - Simple Home Network:
#   STATIC_IP_METHOD=avahi
#   AVAHI_ENABLED=true
#   Result: Easy hostname access on local network
#
# COMBO 4 - Maximum Reliability:
#   STATIC_IP_METHOD=combo
#   MACVLAN_ENABLED=true
#   AVAHI_ENABLED=true
#   DUCKDNS_ENABLED=true
#   Result: All three methods for maximum flexibility

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL database settings
# These are automatically generated during installation for security
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# =============================================================================
# REDIS CONFIGURATION (Caching)
# =============================================================================

# Redis password for caching (automatically generated during installation)
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# =============================================================================
# NEXTCLOUD CONFIGURATION
# =============================================================================

# Nextcloud version to install (latest is recommended)
NEXTCLOUD_VERSION=latest

# Admin user credentials for initial Nextcloud login
# IMPORTANT: Change these to your desired admin username and a strong password
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# PHP memory limit (increase if you have large files or many users)
PHP_MEMORY_LIMIT=512M

# Maximum file upload size (adjust based on your needs)
PHP_UPLOAD_LIMIT=10G

# Maximum number of files that can be uploaded at once
PHP_MAX_FILE_UPLOADS=100

# Docker container resource limits
NEXTCLOUD_MEMORY_LIMIT=1g
NEXTCLOUD_CPU_LIMIT=1.0

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage type: local, device, or docker-volume
# - local: Use a local directory
# - device: Use an external drive/device
# - docker-volume: Use Docker managed storage (default)
STORAGE_TYPE=local

# Directory for Nextcloud data (if using local or device storage)
# Example: /home/user/nextcloud-data or /mnt/external-drive/nextcloud
STORAGE_DATA_DIR=

# Device path (if using external device storage)
# Example: /dev/sdb1
STORAGE_DEVICE=

# Mount point for external storage (if using device storage)
# Example: /mnt/nextcloud-storage
STORAGE_MOUNT_POINT=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# System timezone (automatically detected during installation)
TIMEZONE=UTC

# Version information (automatically set)
KEKELI_VERSION=1.0.0
INSTALLATION_DATE=

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Enable automatic backups
BACKUP_ENABLED=true

# Number of days to keep backups
BACKUP_RETENTION_DAYS=30

# =============================================================================
# FAMILY NETWORK SETUP GUIDE
# =============================================================================

# For consistent family access, follow these steps:
#
# 1. FIND YOUR CURRENT IP:
#    Run: ip addr show | grep "inet " | grep -v "127.0.0.1"
#    Look for your network IP (usually 192.168.x.x or 10.x.x.x)
#
# 2. SET STATIC IP (Choose one method):
#
#    Method A - Router DHCP Reservation (Recommended):
#    - Log into your router's admin panel
#    - Find "DHCP Reservations" or "Static DHCP"
#    - Add your computer's MAC address with desired IP
#    - Restart your computer and router
#
#    Method B - System Static IP:
#    - Configure static IP in your Linux network settings
#    - Use the same IP range as your router (e.g., 192.168.1.x)
#    - Set gateway to your router's IP
#
# 3. UPDATE THIS FILE:
#    - Set PRIMARY_DOMAIN to your static IP
#    - Example: PRIMARY_DOMAIN=192.168.1.100
#
# 4. FAMILY ACCESS:
#    - Family members can bookmark: http://YOUR_IP:8080
#    - Example: http://192.168.1.100:8080
#    - Works on phones, tablets, and computers on the same network
#
# 5. MOBILE SETUP:
#    - Use Nextcloud mobile app
#    - Server URL: http://YOUR_IP:8080
#    - Login with ADMIN_USER and ADMIN_PASSWORD
#
# TROUBLESHOOTING:
# - If IP changes after reboot, DHCP reservation wasn't set up properly
# - If family can't access, check firewall settings
# - If slow access, check PERFORMANCE_CONFIGURATION settings above